# Copy to .env (never commit .env)
DATABASE_URL=postgres://finbiq:finbiq_dev_only@localhost:5432/finbiq
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=finbiq-dev
R2_PUBLIC_URL=

# Google Gemini (AI features read this server-side only; never commit .env)
GEMINI_API_KEY=

# Paystack (use TEST keys while developing; live keys only after launch approval)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
