{
  "$schema": "https://example.com/finbiq-tokens-schema",
  "meta": {
    "name": "FINBIQ Design Tokens",
    "version": "0.2.0",
    "source": "design-preview.html",
    "modes": ["personal", "business"],
    "theme": "deep purple + white"
  },
  "color": {
    "bg": "#FFFFFF",
    "bg2": "#F5F2FF",
    "card": "#FFFFFF",
    "card2": "#F7F4FF",
    "border": "#E3DDF5",
    "text": "#221C3A",
    "muted": "#6F6690",
    "accent": "#5B21B6",
    "accentHi": "#7C3AED",
    "accent2": "#16A34A",
    "info": "#7C3AED",
    "warn": "#D97706",
    "warn2": "#EA580C",
    "danger": "#DC2626",
    "aiBorder": "#C4B5FD",
    "aiBg1": "#EDE9FE",
    "aiBg2": "#FFFFFF",
    "aiText": "#4C1D95"
